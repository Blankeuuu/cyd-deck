<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.3.0</Version>
    <ApplicationIcon>../../../assets/cyd-deck.ico</ApplicationIcon>
    <AssemblyName>CYD-DECK</AssemblyName>
    <RootNamespace>StreamDeck.WindowsAgent</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <Product>CYD-DECK</Product>
    <AssemblyTitle>CYD-DECK</AssemblyTitle>
    <Description>CYD-DECK Windows Agent</Description>
    <Company>Blankeuuu</Company>
    <Copyright>Copyright © Blankeuuu</Copyright>
    <FileVersion>1.3.0</FileVersion>
    <AssemblyVersion>1.3.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shell/shortcut-icons.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamDeck.WindowsAgent.Tests" />
    <InternalsVisibleTo Include="StreamDeck.WindowsAgent.BrandingTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Audio\StreamDeck.Audio\StreamDeck.Audio.csproj" />
    <ProjectReference Include="..\..\Configuration\StreamDeck.Configuration\StreamDeck.Configuration.csproj" />
    <ProjectReference Include="..\..\Covers\StreamDeck.Covers\StreamDeck.Covers.csproj" />
    <ProjectReference Include="..\..\Host\StreamDeck.Host\StreamDeck.Host.csproj" />
    <ProjectReference Include="..\..\Media\StreamDeck.Media\StreamDeck.Media.csproj" />
    <ProjectReference Include="..\..\Shortcuts\StreamDeck.Shortcuts\StreamDeck.Shortcuts.csproj" />
    <ProjectReference Include="..\..\SystemMonitoring\SystemMonitoring.csproj" />
  </ItemGroup>
</Project>
